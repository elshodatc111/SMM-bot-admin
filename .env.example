# ===== AdminBot sozlamalari (.env fayliga nusxalang va to'ldiring) =====

# BotFather bergan token
BOT_TOKEN=

# Server manzili (oxirida / yo'q): https://SIZNING-NOM.alwaysdata.net
BASE_URL=

# Webhook yo'lidagi maxfiy so'z (tasodifiy uzun matn, faqat harf/raqam). tools\gen_secrets.py yaratib beradi
WEBHOOK_SECRET=

# Veb admin panel: parol xeshi (tools\make_admin_hash.py bilan yarating) va sessiya kaliti
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Sizning Telegram ID raqamingiz (bot ogohlantirishlarni shu yerga yuboradi). @userinfobot dan bilib oling
ADMIN_TG_ID=

# Payme Business (kassa sozlamalaridan)
PAYME_MERCHANT_ID=
PAYME_KEY=
# Sinov muhiti uchun 1, ishchi (haqiqiy to'lov) uchun 0
PAYME_TEST=1

# polling = o'z kompyuteringizda sinash (BASE_URL/WEBHOOK_SECRET shart emas)
# webhook = serverda (BASE_URL https:// va WEBHOOK_SECRET shart)
BOT_MODE=polling
